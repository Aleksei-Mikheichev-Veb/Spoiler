# Скопируйте этот файл в .env.local и вставьте свой ключ.
# Ключ выдаёт Telegram-бот https://t.me/poiskkinodev_bot
POISKKINO_API_KEY=

# Пароль на вход для закрытого теста (логин любой). Не задан — сайт открыт.
# Задаётся только на сервере, локально не нужен.
SITE_PASSWORD=

# Отзывы с кнопки «Нашли ошибку?» приходят в Telegram.
# Токен выдаёт @BotFather; id чата — из getUpdates после сообщения боту.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
